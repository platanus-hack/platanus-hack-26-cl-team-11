{
  "name": "ronda",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "concurrently -n back,front -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:back": "npm run dev -w backend",
    "dev:front": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm test -w backend",
    "type-check": "npm run type-check -w backend && npm run type-check -w frontend",
    "add-person": "npm run add-person -w backend --",
    "seed": "npm run seed -w backend --",
    "lint:design": "design/lint.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
