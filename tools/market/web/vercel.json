{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/bolsa",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/avanzado",
      "destination": "/index.html"
    },
    {
      "source": "/agentes",
      "destination": "/agentes.html"
    },
    {
      "source": "/organizador",
      "destination": "/organizador.html"
    },
    {
      "source": "/bolsa",
      "destination": "/apuestas.html"
    },
    {
      "source": "/terminal",
      "destination": "/index.html"
    },
    {
      "source": "/duelos",
      "destination": "/index.html"
    },
    {
      "source": "/api/duelos",
      "destination": "https://ronda-n8if.onrender.com/api/duelos"
    },
    {
      "source": "/api/duelos/:action",
      "destination": "https://ronda-n8if.onrender.com/api/duelos/:action"
    }
  ],
  "headers": [
    {
      "source": "/api/duelos(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/((?:organizador|agentes|bolsa|apuestas)(?:\\.html)?)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/exchange-clock",
      "schedule": "* * 21-23 11 *"
    }
  ]
}
