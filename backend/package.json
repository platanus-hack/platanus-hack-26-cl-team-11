{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "add-person": "tsx src/cli.ts add-person",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit",
    "agents:check": "tsx --env-file-if-exists=../.env src/agents/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
